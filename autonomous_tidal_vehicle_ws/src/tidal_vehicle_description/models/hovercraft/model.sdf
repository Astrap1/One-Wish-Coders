      </axis>
    </joint>
    <joint name="thrust_fan_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>thrust_fan_right</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>5</effort></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>
    <joint name="rudder_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>rudder_left</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.5236</lower><upper>0.5236</upper><effort>5</effort></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>
    <joint name="rudder_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>rudder_right</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.5236</lower><upper>0.5236</upper><effort>5</effort></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>
    <joint name="wheel_leg_fl_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_leg_fl</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>0.0</lower><upper>1.5708</upper><effort>80</effort></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>
    <joint name="wheel_leg_fr_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_leg_fr</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>0.0</lower><upper>1.5708</upper><effort>80</effort></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>
    <joint name="wheel_leg_rl_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_leg_rl</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit><lower>0.0</lower><upper>1.5708</upper><effort>80</effort></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>
    <joint name="wheel_leg_rr_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_leg_rr</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit><lower>0.0</lower><upper>1.5708</upper><effort>80</effort></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>
    <joint name="wheel_shock_fl_joint" type="prismatic">
      <parent>wheel_leg_fl</parent>
      <child>wheel_shock_fl</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.03</lower><upper>0.05</upper><effort>600</effort></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>
    <joint name="wheel_shock_fr_joint" type="prismatic">
      <parent>wheel_leg_fr</parent>
      <child>wheel_shock_fr</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.03</lower><upper>0.05</upper><effort>600</effort></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>
    <joint name="wheel_shock_rl_joint" type="prismatic">
      <parent>wheel_leg_rl</parent>
      <child>wheel_shock_rl</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.03</lower><upper>0.05</upper><effort>600</effort></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>
    <joint name="wheel_shock_rr_joint" type="prismatic">
      <parent>wheel_leg_rr</parent>
      <child>wheel_shock_rr</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.03</lower><upper>0.05</upper><effort>600</effort></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>
    <joint name="wheel_fl_joint" type="revolute">
      <parent>wheel_shock_fl</parent>
      <child>wheel_fl</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>15</effort></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>
    <joint name="wheel_fr_joint" type="revolute">
      <parent>wheel_shock_fr</parent>
      <child>wheel_fr</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>15</effort></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>
    <joint name="wheel_rl_joint" type="revolute">
      <parent>wheel_shock_rl</parent>
      <child>wheel_rl</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>15</effort></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>
    <joint name="wheel_rr_joint" type="revolute">
      <parent>wheel_shock_rr</parent>
      <child>wheel_rr</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>15</effort></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>
    <joint name="payload_box_joint" type="fixed">
      <parent>base_link</parent>
      <child>payload_box</child>
    </joint>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- Air cushion + glide drag + fan thrust + mud resistance (tidal_vehicle_simulation) -->
    <plugin filename="tidal_vehicle_plugins" name="hover::AirCushion">
      <link_name>base_link</link_name>
      <corner>0.420 0.200 -0.200</corner><corner>0.420 -0.200 -0.200</corner><corner>-0.420 0.200 -0.200</corner><corner>-0.420 -0.200 -0.200</corner>
      <target_gap>0.04</target_gap>
      <stiffness>1500</stiffness>
      <damping>130</damping>
      <max_force_factor>2.0</max_force_factor>
      <spinup_time>1.5</spinup_time>
      <glide_linear_drag>5</glide_linear_drag>
      <glide_quadratic_drag>6</glide_quadratic_drag>
      <glide_yaw_drag>4</glide_yaw_drag>
      <glide_lateral_factor>3</glide_lateral_factor>
      <max_thrust>30</max_thrust>
      <thrust_point_left>-0.475 0.175 0.2</thrust_point_left>
      <thrust_point_right>-0.475 -0.175 0.2</thrust_point_right>
      <mud_viscous_drag>150</mud_viscous_drag>
      <mud_rolling_resistance>0.25</mud_rolling_resistance>
      <vent_length>0.05</vent_length>
      <rudder_wash_coeff>0.55</rudder_wash_coeff>
      <heading_kp>40</heading_kp><heading_kd>25</heading_kd>
      <!-- hover-mode velocity control on /model/<name>/cmd_vel_hover (gz.msgs.Twist) -->
      <speed_kp>40</speed_kp><speed_ki>10</speed_ki><yaw_rate_kp>30</yaw_rate_kp>
      <cmd_timeout>0.5</cmd_timeout>
      <use_raycast>true</use_raycast>
      <log_file>/tmp/hover_{model}.csv</log_file>
      <log_joint>wheel_leg_fl_joint</log_joint><log_joint>wheel_leg_fr_joint</log_joint><log_joint>wheel_leg_rl_joint</log_joint><log_joint>wheel_leg_rr_joint</log_joint><log_joint>wheel_shock_fl_joint</log_joint><log_joint>wheel_shock_fr_joint</log_joint><log_joint>wheel_shock_rl_joint</log_joint><log_joint>wheel_shock_rr_joint</log_joint><log_joint>wheel_fl_joint</log_joint><log_joint>wheel_fr_joint</log_joint><log_joint>wheel_rl_joint</log_joint><log_joint>wheel_rr_joint</log_joint>
    </plugin>

    <!-- Ground-mode drive: 4-wheel skid steer on /model/<name>/cmd_vel. Its wheel
         odometry is kept internal; /odom comes from OdometryPublisher below. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <odom_topic>internal/wheel_odometry</odom_topic><tf_topic>internal/wheel_tf</tf_topic>
      <left_joint>wheel_fl_joint</left_joint><left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint><right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>0.900</wheel_separation>
      <wheel_radius>0.150</wheel_radius>
      <max_linear_velocity>2.0</max_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>

    <!-- Leg retract: one controller per leg, all subscribed to the same topic
         /model/<name>/legs_cmd (gz.msgs.Double) so they get the command in the same step.
         0 = legs down (GROUND mode), 1.5708 = folded (HOVER mode). -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>wheel_leg_fl_joint</joint_name>
      <sub_topic>legs_cmd</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>4.0</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
      <cmd_max>1.2</cmd_max><cmd_min>-1.2</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>wheel_leg_fr_joint</joint_name>
      <sub_topic>legs_cmd</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>4.0</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
      <cmd_max>1.2</cmd_max><cmd_min>-1.2</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>wheel_leg_rl_joint</joint_name>
      <sub_topic>legs_cmd</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>4.0</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
      <cmd_max>1.2</cmd_max><cmd_min>-1.2</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>wheel_leg_rr_joint</joint_name>
      <sub_topic>legs_cmd</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>4.0</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
      <cmd_max>1.2</cmd_max><cmd_min>-1.2</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <!-- Suspension spring-damper (wheel_shock_fl): k = 1700.0 N/m, c = 75.0 N s/m -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>wheel_shock_fl_joint</joint_name>
      <p_gain>1700.0</p_gain><i_gain>0</i_gain><d_gain>75.0</d_gain>
      <cmd_max>600</cmd_max><cmd_min>-600</cmd_min>
      <initial_position>-0.03</initial_position>
    </plugin>
    <!-- Suspension spring-damper (wheel_shock_fr): k = 1700.0 N/m, c = 75.0 N s/m -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>wheel_shock_fr_joint</joint_name>
      <p_gain>1700.0</p_gain><i_gain>0</i_gain><d_gain>75.0</d_gain>
      <cmd_max>600</cmd_max><cmd_min>-600</cmd_min>
      <initial_position>-0.03</initial_position>
    </plugin>
    <!-- Suspension spring-damper (wheel_shock_rl): k = 1700.0 N/m, c = 75.0 N s/m -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>wheel_shock_rl_joint</joint_name>
      <p_gain>1700.0</p_gain><i_gain>0</i_gain><d_gain>75.0</d_gain>
      <cmd_max>600</cmd_max><cmd_min>-600</cmd_min>
      <initial_position>-0.03</initial_position>
    </plugin>
    <!-- Suspension spring-damper (wheel_shock_rr): k = 1700.0 N/m, c = 75.0 N s/m -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>wheel_shock_rr_joint</joint_name>
      <p_gain>1700.0</p_gain><i_gain>0</i_gain><d_gain>75.0</d_gain>
      <cmd_max>600</cmd_max><cmd_min>-600</cmd_min>
      <initial_position>-0.03</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rudder_left_joint</joint_name><sub_topic>rudder_left_cmd</sub_topic>
      <p_gain>2</p_gain><d_gain>0.05</d_gain>
      <cmd_max>2</cmd_max><cmd_min>-2</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rudder_right_joint</joint_name><sub_topic>rudder_right_cmd</sub_topic>
      <p_gain>2</p_gain><d_gain>0.05</d_gain>
      <cmd_max>2</cmd_max><cmd_min>-2</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>

    <!-- /odom + TF (odom frame -> base_link). Ground-truth pose, valid in BOTH modes
         (wheel odometry is meaningless while hovering). Idealised: stated in docs. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
