    <!-- Air cushion + glide drag + fan thrust + mud resistance (tidal_vehicle_simulation).
         Gains are the tested Version 1 values scaled to the 300 kg vehicle: same
         cushion natural frequency and damping ratio, drag sized for a ~3 m/s top
         speed at 2 x 200 N, yaw gains scaled with the yaw inertia. The live
         demo uses conservative differential-thrust steering because that is
         more stable than the unvalidated simplified rudder side-force model. -->
    <plugin filename="tidal_vehicle_plugins" name="hover::AirCushion">
      <link_name>base_link</link_name>
      <corner>0.935 0.480 -0.470</corner><corner>0.935 -0.480 -0.470</corner><corner>-0.935 0.480 -0.470</corner><corner>-0.935 -0.480 -0.470</corner>
      <target_gap>0.05</target_gap>
      <stiffness>18000</stiffness>
      <damping>800</damping>
      <max_force_factor>2.0</max_force_factor>
      <spinup_time>2.0</spinup_time>
      <glide_linear_drag>50</glide_linear_drag>
      <glide_quadratic_drag>25</glide_quadratic_drag>
      <glide_yaw_drag>200</glide_yaw_drag>
      <glide_lateral_factor>3</glide_lateral_factor>
      <max_thrust>200</max_thrust>
      <thrust_time_constant>0.4</thrust_time_constant>
      <!-- reversible ducted fans (AGENTS.md): 80 % reverse thrust, so the vehicle
           can brake and hold station on the corridor's ~5 deg shore incline -->
      <reverse_thrust_fraction>0.8</reverse_thrust_fraction>
      <yaw_reserve_fraction>0.3</yaw_reserve_fraction>
      <thrust_point_left>-0.93 0.35 0.53</thrust_point_left>
      <thrust_point_right>-0.93 -0.35 0.53</thrust_point_right>
      <rudder_point>-1.17 0 0.53</rudder_point>
      <mud_viscous_drag>1800</mud_viscous_drag>
      <mud_rolling_resistance>0.25</mud_rolling_resistance>
      <mud_yaw_drag>1000</mud_yaw_drag>
      <water_hull_drag>720</water_hull_drag>
      <water_yaw_drag>500</water_yaw_drag>
      <vent_length>0.06</vent_length>
      <rudder_wash_coeff>0.55</rudder_wash_coeff>
      <!-- The visual rudders remain articulated, but the demo controller uses
           differential fan thrust for yaw. A simplified side-force rudder
           applied high above the cushion created an artificial roll couple in
           DART during low-speed turns. -->
      <rudder_control>false</rudder_control>
      <rudder_max_angle>0.4363</rudder_max_angle>
      <!-- Auxiliary side jets remain available for future validated tuning. -->
      <puff_port_force>0.0</puff_port_force>
      <puff_port_point>0.74 0.6974 0.01</puff_port_point>
      <puff_port_time_constant>0.15</puff_port_time_constant>
      <puff_lateral_gain>150</puff_lateral_gain>
      <!-- sliding shutters show which vents are open (puff_<bow|stern>_<left|right>_cmd) -->
      <puff_shutter_travel>0.26</puff_shutter_travel>
      <heading_kp>600</heading_kp><heading_kd>400</heading_kd>
      <!-- hover-mode velocity control on /model/<name>/cmd_vel_hover (gz.msgs.Twist) -->
      <speed_kp>480</speed_kp><speed_ki>120</speed_ki><yaw_rate_kp>400</yaw_rate_kp>
      <cmd_timeout>0.5</cmd_timeout>
      <use_raycast>true</use_raycast>
      <log_file>/tmp/hover_{model}.csv</log_file>
      <log_joint>track_left_joint</log_joint><log_joint>track_right_joint</log_joint>
      <log_joint>rudder_left_joint</log_joint><log_joint>puff_bow_right_joint</log_joint>
    </plugin>

    <!-- TRACK mode drive: skid steer on /model/<name>/cmd_vel (gz.msgs.Twist).
         TrackController moves each track's contact surface; its odometry is kept
         internal because /odom comes from OdometryPublisher below. -->
    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
      <link>track_left</link>
      <min_velocity>-1.92</min_velocity>
      <max_velocity>1.92</max_velocity>
    </plugin>
    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
      <link>track_right</link>
      <min_velocity>-1.92</min_velocity>
      <max_velocity>1.92</max_velocity>
    </plugin>
    <plugin filename="gz-sim-tracked-vehicle-system" name="gz::sim::systems::TrackedVehicle">
      <left_track><link>track_left</link></left_track>
      <right_track><link>track_right</link></right_track>
      <tracks_separation>0.840</tracks_separation>
      <tracks_height>0.280</tracks_height>
      <steering_efficiency>0.5</steering_efficiency>
      <linear_velocity><min_velocity>-1.5</min_velocity><max_velocity>1.5</max_velocity>
        <min_acceleration>-1.5</min_acceleration><max_acceleration>1.0</max_acceleration></linear_velocity>
      <angular_velocity><min_velocity>-1.0</min_velocity><max_velocity>1.0</max_velocity>
        <min_acceleration>-2.0</min_acceleration><max_acceleration>2.0</max_acceleration></angular_velocity>
      <odom_topic>internal/track_odometry</odom_topic><tf_topic>internal/track_tf</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>

    <!-- Track retract: one controller per track, both on /model/<name>/tracks_cmd
         (gz.msgs.Double) so they move together. 0 = deployed (TRACK mode),
         0.25 = retracted into the hull (HOVER mode). -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>track_left_joint</joint_name>
      <sub_topic>tracks_cmd</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>4.0</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
      <cmd_max>0.2</cmd_max><cmd_min>-0.2</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>track_right_joint</joint_name>
      <sub_topic>tracks_cmd</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>4.0</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
      <cmd_max>0.2</cmd_max><cmd_min>-0.2</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rudder_left_joint</joint_name><sub_topic>rudder_left_cmd</sub_topic>
      <p_gain>20</p_gain><d_gain>0.5</d_gain>
      <cmd_max>20</cmd_max><cmd_min>-20</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rudder_right_joint</joint_name><sub_topic>rudder_right_cmd</sub_topic>
      <p_gain>20</p_gain><d_gain>0.5</d_gain>
      <cmd_max>20</cmd_max><cmd_min>-20</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>puff_bow_left_joint</joint_name><sub_topic>puff_bow_left_cmd</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>10.0</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
      <cmd_max>1.0</cmd_max><cmd_min>-1.0</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>puff_bow_right_joint</joint_name><sub_topic>puff_bow_right_cmd</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>10.0</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
      <cmd_max>1.0</cmd_max><cmd_min>-1.0</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>puff_stern_left_joint</joint_name><sub_topic>puff_stern_left_cmd</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>10.0</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
      <cmd_max>1.0</cmd_max><cmd_min>-1.0</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>puff_stern_right_joint</joint_name><sub_topic>puff_stern_right_cmd</sub_topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>10.0</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
      <cmd_max>1.0</cmd_max><cmd_min>-1.0</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>

    <!-- /odom + TF (map -> base_link). Ground-truth pose, valid in every mode.
         Idealised: stated in docs. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
