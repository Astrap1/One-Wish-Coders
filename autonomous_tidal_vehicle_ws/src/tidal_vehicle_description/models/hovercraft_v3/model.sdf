      </collision>
      <!-- 5 Hz / 360 x 8 is ample for the 0.5 m navigation grid and keeps
           Gazebo responsive under WSLg. Foxglove still receives /scan and the
           raw PointCloud2, so this reduces rendering load rather than demo
           observability. -->
      <sensor name="lidar_3d" type="gpu_lidar"><pose>0 0 0 0 0 0</pose><gz_frame_id>lidar_link</gz_frame_id>
        <always_on>1</always_on><update_rate>5</update_rate><visualize>0</visualize>
        <lidar>
          <scan>
            <horizontal><samples>360</samples><resolution>1</resolution>
              <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <vertical><samples>8</samples><resolution>1</resolution>
              <min_angle>-0.26180</min_angle>
              <max_angle>0.26180</max_angle></vertical>
          </scan>
          <range><min>0.3</min><max>30.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </link>
