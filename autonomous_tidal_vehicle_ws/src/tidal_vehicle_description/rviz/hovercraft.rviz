Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
      Reference Frame: map
    - Class: rviz_default_plugins/RobotModel
      Name: Vehicle
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR points
      Enabled: true
      Topic:
        Value: /points
      Size (m): 0.03
      Style: Points
      Color Transformer: AxisColor
    - Class: rviz_default_plugins/LaserScan
      Name: Scan (2D)
      Enabled: true
      Topic:
        Value: /scan
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 85; 0
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /odom
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Topic:
        Value: /planned_path
    - Class: rviz_default_plugins/Map
      Name: Terrain cost map
      Enabled: true
      Topic:
        Value: /terrain_costmap
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.6
      Yaw: 2.4
      Target Frame: base_link
