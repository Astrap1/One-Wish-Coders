<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="mangrove_07_15m">
    <pose>0 0 0 0 0 0</pose>
    <static>true</static>
    <link name="visual_only_link">
      <!-- Terrain at (14, 7) is approximately 0.03 m above world zero. -->
      <!-- The GLB's trunk is off its origin, at (2.85, -1.86) m unscaled: this
           offset puts the visible tree on the collision proxy and the
           /terrain_costmap footprint. GPU LiDAR sees visuals, so they must match. -->
      <pose>-15.247 9.951 -0.20 1.5708 0 0</pose>
      <visual name="imported_mangrove_visual"><geometry><mesh><uri>model://mangrove_imported/meshes/Mangrovetree.glb</uri><scale>5.35 5.35 5.35</scale></mesh></geometry></visual>
    </link>
    <!-- The converted GLB mesh is the authoritative visual and collision geometry. -->
    <!-- A mesh collision is used so Gazebo physics and LiDAR can detect the tree shape. -->
    <link name="glb_collision_link">
      <pose>0 0 1.088 0 0 0</pose>
      <collision name="glb_mesh_collision">
        <geometry><cylinder><radius>1.3</radius><length>5.0</length></cylinder></geometry>
      </collision>
    </link>
  </model>
</sdf>
