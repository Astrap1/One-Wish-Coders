<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="terrain">
    <static>true</static>
    <!-- Existing collision contract: fixed heightmap with a stronger whole-map shoreline incline. -->
    <link name="heightmap_link">
      <collision name="heightmap_collision">
        <geometry><heightmap><uri>heightmap.png</uri><size>80 80 1.35</size><pos>0 0 0</pos></heightmap></geometry>
      </collision>
    </link>
    <!-- Collision-free organic visual mesh; kept separate for safe iteration. -->
    <link name="terrain_visual_link">
      <visual name="organic_terrain_visual"><material><ambient>0.24 0.16 0.08 1</ambient><diffuse>0.42 0.28 0.12 1</diffuse><specular>0.02 0.02 0.01 1</specular><pbr><metal><albedo_map>model://terrain/materials/mudflat.png</albedo_map><roughness>0.92</roughness><metalness>0.0</metalness></metal></pbr></material>
        <geometry><mesh><uri>meshes/terrain_visual.obj</uri><scale>1.6 1.6 1.12</scale></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
