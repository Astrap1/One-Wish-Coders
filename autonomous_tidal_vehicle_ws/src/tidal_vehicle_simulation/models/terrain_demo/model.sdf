<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="terrain_demo">
    <static>true</static>

    <!--
      The visual mesh preserves the authored mangrove/mudflat scene. A single
      inclined box replaces the 80 m heightmap collision for DART/Bullet: the
      air-cushion model needs a stable surface to raycast, whereas the mission
      terrain semantics come from TerrainZones and /terrain_costmap. This keeps
      the live demo fast without representing the collision plane as surveyed
      mangrove topography.
    -->
    <link name="demo_ground_link">
      <collision name="demo_ground_collision">
        <pose>0 0 -0.10 0 0 0</pose>
        <geometry><box><size>80 80 0.20</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
    </link>
    <link name="terrain_visual_link">
      <visual name="organic_terrain_visual">
        <geometry><mesh><uri>model://terrain/meshes/terrain_visual.obj</uri><scale>1.6 1.6 1.12</scale></mesh></geometry>
        <material>
          <ambient>0.24 0.16 0.08 1</ambient><diffuse>0.42 0.28 0.12 1</diffuse><specular>0.02 0.02 0.01 1</specular>
          <pbr><metal><albedo_map>model://terrain/materials/mudflat.png</albedo_map><roughness>0.92</roughness><metalness>0.0</metalness></metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
