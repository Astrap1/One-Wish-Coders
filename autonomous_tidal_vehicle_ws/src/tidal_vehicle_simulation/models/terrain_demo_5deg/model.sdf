<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="terrain_demo_5deg">
    <static>true</static>

    <!--
      Ninety-six-metre tidal valley from x=4 to x=100. Extended 5-degree bank
      slopes lead into long gentle lower slopes and a narrow z=-3 m centre,
      so low tide begins as a small channel and expands across the valley.
      Primitive collision keeps DART/Bullet ray casts stable and inexpensive.
    -->
    <link name="demo_ground_link">
      <collision name="home_plateau_collision">
        <pose>-4 0 -0.10 0 0 0</pose>
        <geometry><box><size>16 60 0.20</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="home_slope_5deg_collision">
        <pose>9.7150 0 -0.5996 0 0.087266 0</pose>
        <geometry><box><size>11.4737 60 0.20</size></box></geometry>
        <surface><friction><ode><mu>0.65</mu><mu2>0.65</mu2></ode></friction></surface>
      </collision>
      <collision name="lower_home_slope_collision">
        <pose>32.7150 0 -2.0998 0 0.057789 0</pose>
        <geometry><box><size>34.6279 60 0.20</size></box></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
      <collision name="centre_floor_collision">
        <pose>52 0 -3.10 0 0 0</pose>
        <geometry><box><size>4 60 0.20</size></box></geometry>
        <surface><friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction></surface>
      </collision>
      <collision name="lower_delivery_slope_collision">
        <pose>71.2850 0 -2.0998 0 -0.057789 0</pose>
        <geometry><box><size>34.6279 60 0.20</size></box></geometry>
        <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
      </collision>
      <collision name="delivery_slope_5deg_collision">
        <pose>94.2850 0 -0.5996 0 -0.087266 0</pose>
        <geometry><box><size>11.4737 60 0.20</size></box></geometry>
        <surface><friction><ode><mu>0.65</mu><mu2>0.65</mu2></ode></friction></surface>
      </collision>
      <collision name="delivery_plateau_collision">
        <pose>104 0 -0.10 0 0 0</pose>
        <geometry><box><size>8 60 0.20</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
    </link>
    <link name="terrain_visual_link">
      <visual name="home_plateau_visual"><pose>-4 0 -0.10 0 0 0</pose><geometry><box><size>16 60 0.20</size></box></geometry><material><ambient>0.24 0.16 0.08 1</ambient><diffuse>0.42 0.28 0.12 1</diffuse></material></visual>
      <visual name="home_slope_5deg_visual"><pose>9.7150 0 -0.5996 0 0.087266 0</pose><geometry><box><size>11.4737 60 0.20</size></box></geometry><material><ambient>0.19 0.13 0.06 1</ambient><diffuse>0.34 0.23 0.11 1</diffuse></material></visual>
      <visual name="lower_home_slope_visual"><pose>32.7150 0 -2.0998 0 0.057789 0</pose><geometry><box><size>34.6279 60 0.20</size></box></geometry><material><ambient>0.14 0.10 0.05 1</ambient><diffuse>0.27 0.19 0.09 1</diffuse></material></visual>
      <visual name="centre_floor_visual"><pose>52 0 -3.10 0 0 0</pose><geometry><box><size>4 60 0.20</size></box></geometry><material><ambient>0.10 0.08 0.04 1</ambient><diffuse>0.20 0.15 0.08 1</diffuse></material></visual>
      <visual name="lower_delivery_slope_visual"><pose>71.2850 0 -2.0998 0 -0.057789 0</pose><geometry><box><size>34.6279 60 0.20</size></box></geometry><material><ambient>0.14 0.10 0.05 1</ambient><diffuse>0.27 0.19 0.09 1</diffuse></material></visual>
      <visual name="delivery_slope_5deg_visual"><pose>94.2850 0 -0.5996 0 -0.087266 0</pose><geometry><box><size>11.4737 60 0.20</size></box></geometry><material><ambient>0.19 0.13 0.06 1</ambient><diffuse>0.34 0.23 0.11 1</diffuse></material></visual>
      <visual name="delivery_plateau_visual"><pose>104 0 -0.10 0 0 0</pose><geometry><box><size>8 60 0.20</size></box></geometry><material><ambient>0.22 0.16 0.07 1</ambient><diffuse>0.40 0.31 0.15 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
