<?xml version="1.0"?>
<package format="3">
  <name>tidal_vehicle_simulation</name>
  <version>0.1.0</version>
  <description>Gazebo tidal-corridor worlds, the air-cushion vehicle plugins and the vehicle mobility node.</description>
  <maintainer email="team@example.com">One Wish Coders</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Gazebo Harmonic libraries (provided by ros_gz on Jazzy) -->
  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>tidal_vehicle_interfaces</exec_depend>
  <exec_depend>tidal_vehicle_description</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
