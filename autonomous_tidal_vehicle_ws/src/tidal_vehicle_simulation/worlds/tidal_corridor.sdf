<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="tidal_corridor"><scene><ambient>0.68 0.72 0.66 1</ambient><background>0.72 0.80 0.86 1</background><shadows>true</shadows></scene><gui><camera name="overview"><pose>55 -65 50 0.48 0 2.30</pose></camera></gui>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>-20 -20 30 0.45 -0.35 -0.65</pose><diffuse>1.0 0.94 0.78 1</diffuse><specular>0.35 0.35 0.30 1</specular><direction>0.25 0.35 -0.90</direction></light>
    <physics name="default_physics" type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor><real_time_update_rate>250</real_time_update_rate></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <include><uri>model://terrain</uri><name>fixed_terrain</name><pose>0 0 0 0 0.08 0</pose></include>
    <include><uri>model://mangrove_imported</uri><name>mangrove_imported</name></include>
    <!-- The terrain model below is the full 50 x 50 m inclined platform. -->
    <!-- Broad coastal water sheet rises over the low side of the inclined terrain. -->
    <model name="coastal_water">
      <pose>10 0 -1.80 0 0 0</pose>
      <static>false</static>
      <link name="water_link">
        <gravity>false</gravity>
        <visual name="rising_water_volume"><pose>0 0 -0.25 0 0 0</pose><geometry><box><size>60 80 0.50</size></box></geometry><material><ambient>0.04 0.12 0.11 1</ambient><diffuse>0.12 0.30 0.27 1</diffuse><specular>0.20 0.32 0.28 1</specular><pbr><metal><albedo_map>model://terrain/materials/tidal_water.png</albedo_map><roughness>0.18</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
      <plugin filename="libtide_visual_system.so" name="tidal_vehicle_simulation::TideVisualSystem"><initial_level_m>0.02</initial_level_m><rise_m>4.80</rise_m><duration_s>30.0</duration_s></plugin>
    </model>
  </world>
</sdf>
