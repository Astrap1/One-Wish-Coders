<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="tidal_corridor">
    <scene>
      <ambient>0.68 0.72 0.66 1</ambient>
      <background>0.52 0.72 0.90 1</background>
      <sky>
        <time>9.5</time>
        <sunrise>6.0</sunrise>
        <sunset>18.5</sunset>
        <clouds>
          <speed>0.15</speed>
          <direction>0.8</direction>
          <humidity>0.55</humidity>
          <mean_size>0.45</mean_size>
          <ambient>0.82 0.86 0.90 1</ambient>
        </clouds>
      </sky>
      <shadows>true</shadows>
    </scene>
    <gui><camera name="overview"><pose>55 -65 50 0.48 0 2.30</pose></camera></gui>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>-20 -20 30 0.45 -0.35 -0.65</pose><diffuse>1.0 0.94 0.78 1</diffuse><specular>0.35 0.35 0.30 1</specular><direction>0.25 0.35 -0.90</direction></light>
    <!-- DART + Bullet is required by the air-cushion raycast model. -->
    <physics name="2ms" type="dart"><max_step_size>0.002</max_step_size><real_time_factor>1.0</real_time_factor><dart><collision_detector>bullet</collision_detector></dart></physics>
    <gravity>0 0 -9.81</gravity>
    <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><latitude_deg>1.4466</latitude_deg><longitude_deg>103.7300</longitude_deg><elevation>0</elevation><heading_deg>0</heading_deg></spherical_coordinates>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <!-- The visible sheet has no collision. TerrainZones supplies the physical
         support surface and water drag used by the air-cushion controller. -->
    <plugin filename="tidal_vehicle_plugins" name="hover::TerrainZones">
      <ground_height>-3.0</ground_height>
      <zone><name>muddy_valley</name><type>MUD</type><min>4 -30</min><max>100 30</max></zone>
      <zone><name>tidal_channel</name><type>WATER</type><min>4 -30</min><max>100 30</max><level>-2.80</level><rise>2.80</rise><rise_start>0</rise_start><rise_duration>180.0</rise_duration></zone>
    </plugin>
    <!-- Water occupies 80 percent of the 120 m corridor; mirrored 15-degree slopes reach z=-3 m. -->
    <include><uri>model://terrain_demo</uri><name>demo_terrain</name><pose>0 0 0 0 0 0</pose></include>
    <!-- HOME: firm shore staging zone, shared with Safety's default map-frame pose. -->
    <!-- The vehicle (vehicle:=v2 tracked, or v1 wheeled) is spawned here by sim.launch.py. -->
    <!-- Mangroves follow the wet margins while leaving a broad route near y=0. -->
    <include><uri>model://mangrove_01_7m</uri><name>mangrove_01</name><pose>-8.000 -22 0.000 0 0 0.20</pose></include>
    <include><uri>model://mangrove_02_8m</uri><name>mangrove_02</name><pose>5.412 24 -0.378 0 0 1.10</pose></include>
    <include><uri>model://mangrove_03_10m</uri><name>mangrove_03</name><pose>18.824 -19 -1.525 0 0 2.30</pose></include>
    <include><uri>model://mangrove_04_11m</uri><name>mangrove_04</name><pose>28.882 21 -2.001 0 0 4.60</pose></include>
    <include><uri>model://mangrove_05_13m</uri><name>mangrove_05</name><pose>92.588 -23 -1.174 0 0 0.70</pose></include>
    <include><uri>model://mangrove_06_14m</uri><name>mangrove_06</name><pose>100.412 22 0.000 0 0 3.50</pose></include>
    <include><uri>model://mangrove_07_15m</uri><name>mangrove_07</name><pose>35.588 -17 -2.318 0 0 5.40</pose></include>
    <include><uri>model://mangrove_08_12m</uri><name>mangrove_08</name><pose>41.176 18 -2.582 0 0 1.90</pose></include>
    <include><uri>model://mangrove_09_11m</uri><name>mangrove_09</name><pose>46.765 -24 -2.847 0 0 0.40</pose></include>
    <include><uri>model://mangrove_10_9m</uri><name>mangrove_10</name><pose>50.118 23 -3.000 0 0 4.10</pose></include>
    <include><uri>model://mangrove_01_7m</uri><name>mangrove_11</name><pose>54.588 -16 -2.972 0 0 2.80</pose></include>
    <include><uri>model://mangrove_02_8m</uri><name>mangrove_12</name><pose>57.941 17 -2.814 0 0 5.80</pose></include>
    <include><uri>model://mangrove_03_10m</uri><name>mangrove_13</name><pose>64.647 -23 -2.496 0 0 1.40</pose></include>
    <include><uri>model://mangrove_04_11m</uri><name>mangrove_14</name><pose>68.000 22 -2.338 0 0 3.90</pose></include>
    <include><uri>model://mangrove_05_13m</uri><name>mangrove_15</name><pose>72.471 -18 -2.126 0 0 0.90</pose></include>
    <include><uri>model://mangrove_06_14m</uri><name>mangrove_16</name><pose>-2.412 14 0.000 0 0 5.10</pose></include>
    <include><uri>model://mangrove_07_15m</uri><name>mangrove_17</name><pose>14.353 -13 -1.313 0 0 2.00</pose></include>
    <include><uri>model://mangrove_08_12m</uri><name>mangrove_18</name><pose>81.412 13 -1.703 0 0 4.80</pose></include>
    <include><uri>model://mangrove_09_11m</uri><name>mangrove_19</name><pose>87.000 -12 -1.439 0 0 1.60</pose></include>
    <!-- Rocks form irregular bank and channel-edge clusters; the centre remains navigable. -->
    <include><uri>model://rock_imported</uri><name>rock_01</name><pose>-0.176 -9 0.000 0 0 0.35</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_02</name><pose>18.824 10 -1.525 0 0 1.20</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_03</name><pose>33.353 -10 -2.212 0 0 2.10</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_04</name><pose>36.706 11 -2.371 0 0 2.75</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_05</name><pose>40.059 -7 -2.530 0 0 0.80</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_06</name><pose>43.412 9 -2.688 0 0 1.85</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_07</name><pose>46.765 -12 -2.847 0 0 4.00</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_08</name><pose>50.118 8 -3.000 0 0 5.20</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_09</name><pose>53.471 -10 -3.000 0 0 0.50</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_10</name><pose>57.941 12 -2.814 0 0 2.40</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_11</name><pose>64.647 -7 -2.496 0 0 3.60</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_12</name><pose>69.118 10 -2.285 0 0 5.80</pose></include>
    <!-- Additional rocks blend the wet margins into both high grounds. -->
    <include><uri>model://rock_imported</uri><name>rock_left_01</name><pose>72.471 -11 -2.126 0 0 0.40</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_left_02</name><pose>75.824 8 -1.967 0 0 1.50</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_left_03</name><pose>80.294 -9 -1.756 0 0 2.30</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_left_04</name><pose>85.882 11 -1.491 0 0 3.10</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_left_05</name><pose>94.824 8 -1.068 0 0 4.20</pose></include>
    <include><uri>model://rock_imported</uri><name>rock_left_06</name><pose>106.000 -10 0.000 0 0 5.40</pose></include>
    <!-- Visual-only delivery zone on the far high ground (goal: x=104, y=0). -->
    <model name="delivery_zone"><static>true</static><pose>104 0 0.02 0 0 0</pose>
      <link name="marker_link">
        <visual name="landing_pad"><geometry><cylinder><radius>2.0</radius><length>0.04</length></cylinder></geometry><material><ambient>0.05 0.35 0.12 1</ambient><diffuse>0.08 0.70 0.20 1</diffuse><emissive>0.02 0.15 0.04 1</emissive></material></visual>
      </link>
    </model>
    <!-- The water spans the full valley and passes visually through trees and rocks. -->
    <!-- The visible water and the AirCushion's TerrainZones surface share the
         same -2.80 m initial level and gradual 2.80 m / 180 s rise. -->
    <model name="coastal_water">
      <pose>52 0 -2.80 0 0 0</pose>
      <static>false</static>
      <link name="water_link">
        <gravity>false</gravity>
        <!-- A thin sheet keeps the operator view visibly level; the moving
             support surface itself is supplied by TerrainZones/AirCushion. -->
        <visual name="rising_water_surface"><pose>0 0 -0.04 0 0 0</pose><geometry><box><size>96 60 0.08</size></box></geometry><material><ambient>0.04 0.12 0.11 1</ambient><diffuse>0.12 0.30 0.27 1</diffuse><specular>0.20 0.32 0.28 1</specular><pbr><metal><albedo_map>model://terrain/materials/tidal_water.png</albedo_map><roughness>0.18</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
      <plugin filename="libtide_visual_system.so" name="tidal_vehicle_simulation::TideVisualSystem"><initial_level_m>-2.80</initial_level_m><rise_m>2.80</rise_m><duration_s>180.0</duration_s></plugin>
    </model>
  </world>
</sdf>
