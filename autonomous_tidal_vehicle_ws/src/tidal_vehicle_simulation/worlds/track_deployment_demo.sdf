<?xml version="1.0"?>
<!-- Compact V3 mobility demonstration: flat launch, 15 degree firm bank,
     and upper recovery platform. The vehicle is spawned at (0, 0) by
     sim.launch.py and must be driven through the ordinary ROS command path. -->
<sdf version="1.9">
  <world name="track_deployment_demo">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor>
      <dart><collision_detector>bullet</collision_detector></dart>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>1.4466</latitude_deg><longitude_deg>103.7300</longitude_deg>
      <elevation>0</elevation><heading_deg>0</heading_deg>
    </spherical_coordinates>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- No mud or water zones: terrain truth is FIRM everywhere. -->
    <plugin filename="tidal_vehicle_plugins" name="hover::TerrainZones">
      <ground_height>0.0</ground_height>
    </plugin>

    <scene><ambient>0.45 0.48 0.50 1</ambient><background>0.12 0.18 0.24 1</background><grid>true</grid></scene>
    <light type="directional" name="sun">
      <pose>0 0 12 0 0 0</pose><diffuse>0.95 0.93 0.85 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular><direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- Flat launch surface: x = -10 to 10, z = 0. -->
    <model name="lower_platform"><static>true</static><pose>0 0 -0.20 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>20 12 0.40</size></box></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>20 12 0.40</size></box></geometry><material><ambient>0.30 0.42 0.27 1</ambient><diffuse>0.30 0.42 0.27 1</diffuse></material></visual></link>
    </model>
    <!-- 8 m long along its surface, rising 2.07 m over 7.73 m horizontally. -->
    <model name="firm_bank_15deg"><static>true</static><pose>13.916 0 0.842 0 -0.26180 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>8 12 0.40</size></box></geometry><surface><friction><ode><mu>1.3</mu><mu2>1.3</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>8 12 0.40</size></box></geometry><material><ambient>0.52 0.36 0.19 1</ambient><diffuse>0.52 0.36 0.19 1</diffuse></material></visual></link>
    </model>
    <model name="upper_platform"><static>true</static><pose>24.864 0 1.870 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>14.272 12 0.40</size></box></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>14.272 12 0.40</size></box></geometry><material><ambient>0.30 0.42 0.27 1</ambient><diffuse>0.30 0.42 0.27 1</diffuse></material></visual></link>
    </model>
    <model name="start_marker"><static>true</static><pose>0 0 0.03 0 0 0</pose><link name="link"><visual name="visual"><geometry><cylinder><radius>1.1</radius><length>0.06</length></cylinder></geometry><material><emissive>0.05 0.80 0.25 1</emissive></material></visual></link></model>
    <model name="top_marker"><static>true</static><pose>24 0 2.10 0 0 0</pose><link name="link"><visual name="visual"><geometry><cylinder><radius>1.2</radius><length>0.06</length></cylinder></geometry><material><emissive>0.95 0.65 0.05 1</emissive></material></visual></link></model>
    <model name="backdrop"><static>true</static><pose>12 0 -0.46 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>70 70 0.02</size></box></geometry><material><ambient>0.08 0.13 0.10 1</ambient><diffuse>0.08 0.13 0.10 1</diffuse></material></visual></link></model>
  </world>
</sdf>
